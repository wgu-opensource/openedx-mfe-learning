{
  "name": "@wgu-opensource/openedx-mfe-learning",
  "version": "21.0.0",
  "description": "Learning Experience for OpenEDX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wgu-opensource/openedx-mfe-learning.git"
  },
  "browserslist": [
    "extends @edx/browserslist-config"
  ],
  "scripts": {
    "build": "fedx-scripts webpack",
    "postinstall": "patch-package",
    "i18n_extract": "BABEL_ENV=i18n fedx-scripts babel src --quiet > /dev/null",
    "lint": "fedx-scripts eslint --ext .js --ext .jsx .",
    "lint:fix": "fedx-scripts eslint --fix --ext .js --ext .jsx .",
    "prepare": "husky install",
    "snapshot": "fedx-scripts jest --updateSnapshot",
    "start": "fedx-scripts webpack-dev-server --progress",
    "pretest": "webpack --mode development --config webpack.test.config.js",
    "test": "fedx-scripts jest --coverage --passWithNoTests"
  },
  "lint-staged": {
    "**/*.{js,jsx}": [
      "fedx-scripts eslint --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged"
    }
  },
  "author": "WGU",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/wgu-opensource/openedx-mfe-learning#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/wgu-opensource/openedx-mfe-learning/issues"
  },
  "dependencies": {
    "@edx/brand": "npm:@openedx/brand-openedx@^1.2.2",
    "@edx/frontend-app-learning": "github:wgu-opensource/frontend-app-learning#ulmo-dist",
    "@edx/frontend-component-footer": "^14.6.0",
    "@edx/frontend-component-header": "^8.0.0",
    "@edx/frontend-lib-special-exams": "^4.0.0",
    "@edx/frontend-platform": "^8.4.0",
    "@fortawesome/fontawesome-svg-core": "1.3.0",
    "@fortawesome/free-brands-svg-icons": "5.15.4",
    "@fortawesome/free-regular-svg-icons": "5.15.4",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "@fortawesome/react-fontawesome": "^0.1.4",
    "@openedx/paragon": "^23.4.5",
    "@reduxjs/toolkit": "1.9.7",
    "classnames": "2.5.1",
    "core-js": "3.31.1",
    "husky": "7.0.4",
    "patch-package": "^8.0.0",
    "prop-types": "15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "6.1.0",
    "react-intl": "^5.25.0",
    "react-redux": "7.2.9",
    "react-responsive": "8.2.0",
    "react-router": "6.15.0",
    "react-router-dom": "6.15.0",
    "react-transition-group": "4.4.5",
    "redux": "4.2.1",
    "regenerator-runtime": "0.13.11",
    "reselect": "4.1.8",
    "sass": "^1.79.3"
  },
  "devDependencies": {
    "@edx/browserslist-config": "1.5.0",
    "@edx/reactifex": "^2.2.0",
    "@openedx/frontend-build": "^14.6.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "axios-mock-adapter": "2.1.0",
    "glob": "7.2.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "^14.0.1",
    "mini-css-extract-plugin": "^2.7.6",
    "rosie": "2.1.1"
  },
  "volta": {
    "node": "18.19.1"
  }
}
